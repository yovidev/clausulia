# PostgreSQL
POSTGRES_USER=clausulia
POSTGRES_PASSWORD=clausulia
POSTGRES_DB=clausulia
DATABASE_URL=postgresql+psycopg://clausulia:clausulia@postgres:5432/clausulia

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Archivos
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=500

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PROVIDER=fastembed
EMBEDDING_CACHE_DIR=/models
# Antepone "Documento: <nombre>" al vectorizar (desactivada: empeora el rechazo en eval)
EMBED_DOCUMENT_TITLE=false

# Chunking y recuperación (calibrados con backend/eval, ver backend/eval/results.md)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
# Similitud mínima del mejor chunk para llamar al LLM; si se llama, recibe los K chunks
SIMILARITY_THRESHOLD=0.50
# vector | hybrid (coseno + full-text con Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATES=20
RRF_K=60
CONFIDENCE_HIGH_SIMILARITY=0.6
CONFIDENCE_MEDIUM_SIMILARITY=0.45

# LLM: "mock" funciona sin claves; "openai" requiere OPENAI_API_KEY
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000