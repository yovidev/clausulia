# PostgreSQL
POSTGRES_USER=clausulia
POSTGRES_PASSWORD=clausulia
POSTGRES_DB=clausulia
DATABASE_URL=postgresql+psycopg://clausulia:clausulia@postgres:5432/clausulia

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Archivos
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=500

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Chunking y recuperación (valores iniciales, se calibran con la evaluación)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=6
SIMILARITY_THRESHOLD=0.35

# LLM: "mock" funciona sin claves; "openai" requiere OPENAI_API_KEY
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000